rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{doc} {
      allow read: if true;
      allow write: if true;
    }
    match /orders/{doc} {
      allow read: if true;
      allow write: if true;
    }
    match /analytics_events/{doc} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if true;
    }
  }
}
